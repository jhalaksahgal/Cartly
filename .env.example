# No environment variables are required to run this application.
#
# There is no database, no mandatory API key and no required third-party
# service: speech recognition runs in the browser, and the NLP, catalogue,
# search and recommendation engines are all local Python. Copy this file to
# .env only if you want the optional extras below. .env is gitignored.


# ---------------------------------------------------------------------------
# Optional: LLM fallback
# ---------------------------------------------------------------------------
# Setting a key enables a Groq-backed fallback that runs ONLY when the
# deterministic parser returns UNKNOWN. With no key the app is fully
# functional and completely offline.
#
# Get a free key at https://console.groq.com. Set it in your hosting
# provider's dashboard rather than committing it anywhere.
#
# GROQ_API_KEY=

# Model used by the fallback.
# GROQ_MODEL=llama-3.3-70b-versatile

# Seconds to wait before giving up on the fallback and returning UNKNOWN.
# Kept short on purpose: this sits between the user and their answer.
# GROQ_TIMEOUT=4.0


# ---------------------------------------------------------------------------
# Optional: runtime
# ---------------------------------------------------------------------------
# Port to bind. Every supported platform sets this automatically; only set it
# yourself when running locally on a non-default port.
# PORT=8000

# Uvicorn log level: critical | error | warning | info | debug | trace
# LOG_LEVEL=info
